// ============================================================================
//  ВАЛ (шпиндель)
//
//  Диаметр 7.1 мм выбран не случайно: это же и центрирующий штырь под
//  отверстие пластинки, поэтому вал проходит сквозь диск и выступает над
//  пластинкой. Две кольцевые канавки — под стопорные винты колеса и диска;
//  канавка (а не лыска) не требует определённого поворота вала и заодно
//  держит деталь по высоте.
//
//  Печать: стоя, торцом на стол, 100% заполнение, минимальная скорость.
//  Это расходная деталь прототипа: как только всё поедет — заменить
//  отрезком шлифованного стального прутка (тогда spindle_d = 8).
// ============================================================================

include <../params.scad>
use <../lib/common.scad>

module spindle() {
    translate([platter_pos[0], platter_pos[1], spindle_bottom_z]) difference() {
        chamfered_cyl(spindle_d, spindle_len, ch = 0.5);
        // кольцевые канавки под стопорные винты
        for (z = spindle_set_z)
            translate([0, 0, z - spindle_bottom_z]) difference() {
                cylinder(d = spindle_d + 2, h = spindle_groove_h, center = true);
                cylinder(d = spindle_d - 2*spindle_groove_depth,
                         h = spindle_groove_h + 2*eps, center = true);
            }
    }
}

spindle();
