// ============================================================================
//  МАТ НА ДИСК — печатный из TPU
//
//  Лежит в утоплении диска (1 мм) и выступает над ним на оставшийся
//  миллиметр: пластинка не касается жёсткого PLA. Центр — отверстие под
//  штырь 7.1 мм. Зазоры mat_od_clr / mat_hole_clr, потому что TPU
//  размерно «плывёт» сильнее обычного пластика.
//
//  Печать: TPU 95A, перевернуть — рабочей плоскостью на стол (она будет
//  гладкой под пластинку). 2-3 периметра, infill 15-20%, без поддержек.
// ============================================================================

include <../params.scad>
use <../lib/common.scad>

module mat() {
    translate([platter_pos[0], platter_pos[1],
               platter_top_z - platter_mat_recess]) difference() {
        chamfered_cyl(platter_mat_d - mat_od_clr, mat_t, ch = 0.3);
        thru(spindle_tip_d + mat_hole_clr, mat_t);
    }
}

mat();
