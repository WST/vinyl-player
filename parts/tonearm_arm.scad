// ============================================================================
//  ТОНАРМ: ступица качания + трубка + хвостовик противовеса
//
//  Головка звукоснимателя — отдельная деталь (tonearm_headshell.scad),
//  она надевается хомутом на конец трубки. Поэтому трубка здесь открыта с
//  торца: провод от AT91 протягивается насквозь ещё до установки головки,
//  выходит вниз из ступицы, дальше через палец вертикальной оси и стойку —
//  внутрь корпуса. Слабина провода служит и токоподводом, и мягким
//  ограничителем поворота. Микролифта нет (сознательно, см. README).
//
//  Геометрия трубки (длина, углы) считается в params.scad из эффективной
//  длины, выноса и разворота головки — см. раздел про тонарм в README.
//
//  Печать: деталь длинная, печатать лежа; ступица ложится на стол, под
//  трубку — лёгкие поддержки. Альтернатива на будущее: карбоновая трубка
//  10x1 вместо печатной.
// ============================================================================

include <../params.scad>
use <../lib/common.scad>

module tonearm_arm(az = arm_tube_azimuth_at(arm_groove_r_out)) {
    translate([arm_pivot_pos[0], arm_pivot_pos[1], arm_axis_z]) rotate([0, 0, az])
    difference() {
        union() {
            // ---- ступица качания ----
            translate([0, 0, -arm_hub_h/2])
                linear_extrude(height = arm_hub_h)
                    rrect(arm_hub_len, arm_hub_w, 3);
            // ---- трубка (торец с фаской — по нему надевается хомут) ----
            rotate([0, 90, 0])
                chamfered_cyl(arm_tube_od, arm_tube_reach, ch = 0.6,
                              bottom = false, top = true);
            // ---- хвостовик противовеса ----
            rotate([0, -90, 0])
                cylinder(d = arm_cw_stub_d, h = arm_cw_stub_len);
        }
        // ---- конусные гнёзда осей качания (конус 90 град, как заточка
        //      винта); начинаются чуть снаружи, чтобы срез был чистым ----
        for (s = [-1, 1])
            translate([0, s*(arm_hub_w/2 + 0.3), 0]) rotate([s*90, 0, 0])
                cylinder(d1 = arm_pivot_cone_d + 0.6, d2 = 0.2,
                         h = arm_pivot_cone_depth + 0.3);
        // ---- канал сигнального провода ----
        // Канал заходит за ось качания, чтобы вертикальный выход попадал в
        // него целиком, а не упирался в слепой карман.
        translate([-4, 0, 0]) rotate([0, 90, 0])
            cylinder(d = arm_tube_id, h = arm_tube_reach + 4 + eps);
        translate([0, 0, -arm_hub_h/2 - eps])
            cylinder(d = arm_wire_exit_d, h = arm_hub_h/2 + 2);
        // ---- лыска под прижимной винт хомута головки ----
        // Она же задаёт повторяемое угловое положение головки.
        translate([arm_tube_reach - arm_joint_len, -arm_tube_od, arm_joint_scr_z])
            cube([arm_joint_len + 1, 2*arm_tube_od, arm_tube_od]);
    }
}

tonearm_arm();
