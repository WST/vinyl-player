// ============================================================================
//  ОСЬ ВЕРТИКАЛЬНОГО ПОДШИПНИКА ТОНАРМА (палец)
//
//  Сделана отдельной деталью не из любви к деталям, а ради печати:
//  так и палец, и вилка печатаются в идеальной ориентации без поддержек,
//  а рабочая поверхность пальца выходит круглой.
//  Запрессовывается в вилку, работает в канале стойки (со смазкой).
//  Полый — внутри проходит сигнальный провод.
//
//  Хороший апгрейд: заменить отрезком стальной трубки 8x1.5 мм.
//
//  Печать: стоя, 100% заполнение.
// ============================================================================

include <../params.scad>
use <../lib/common.scad>

module tonearm_pin() {
    translate([arm_pivot_pos[0], arm_pivot_pos[1],
               arm_pillar_top_z + arm_yoke_bar_t - arm_pin_len])
        difference() {
            chamfered_cyl(arm_pivot_shaft_d, arm_pin_len, ch = 0.5);
            thru(arm_pivot_wire_d, arm_pin_len);
        }
}

tonearm_pin();
