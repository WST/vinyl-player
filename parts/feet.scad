include <../params.scad>
use <../lib/common.scad>

module foot() {
    translate([0, 0, -foot_h])
        chamfered_cyl(foot_d, foot_h, ch = foot_ch, bottom = true, top = false);
}

module feet() {
    for (p = foot_pos)
        translate([p[0], p[1], 0]) foot();
}

feet();
