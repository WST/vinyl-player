// ============================================================================
//  ВАЛ ДИСКА — печатный, вместо стального прутка 8 мм
//
//  Тело с компенсацией печати (rod_print_clr). Кончик 7.1 мм проверен
//  — не менять.
//  Снизу буртик вместо термоусадки: упирается во внутреннее кольцо нижнего
//  подшипника и не даёт вытянуть вал вверх вместе с диском.
//  Сверху уступ 8→7.1: на него садится диск (снимается вверх), кончик
//  7.1 мм центрирует пластинку (~7.2 мм). Колесо на прототипе клеится;
//  лыска под винт колеса — rod_set_screws в drive_params.scad.
//
//  Печать: стоя, буртиком на стол, 100% заполнение. Посадку в подшипник
//  правит rod_print_clr — проще напечатать короткий обломок и подобрать.
// ============================================================================

include <../drive_params.scad>
use <../../lib/common.scad>
use <../drive_lib.scad>

module drive_spindle_shaft() {
    translate([spindle_pos[0], spindle_pos[1], 0]) difference() {
        printed_shaft_body(spindle_top_z, spindle_tip_len);
        if (rod_set_screws) shaft_flat(spindle_set_z);
    }
}

drive_spindle_shaft();
