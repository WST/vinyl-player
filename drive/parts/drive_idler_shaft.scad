include <../drive_params.scad>
use <../../lib/common.scad>
use <../drive_lib.scad>

module drive_idler_shaft() {
    translate([idler_pos[0], idler_pos[1], 0]) difference() {
        printed_shaft_body(idler_rod_top_z);
        shaft_flat(idler_set_z);
    }
}

drive_idler_shaft();
